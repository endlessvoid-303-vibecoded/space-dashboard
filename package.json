{
  "name": "space-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A nerdy 3D space dashboard with launch site logos, live launches, and webcasts",
  "scripts": {
    "dev": "svelte-kit dev",
    "build": "vite build && svelte-kit prerender",
    "preview": "svelte-kit preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "lint:fix": "prettier --write . && eslint . --fix --max-warnings 0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-vercel": "^6.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^2.44.0",
    "globe.gl": "^2.31.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-preprocess": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "dependencies": {},
  "type": "module"
}
